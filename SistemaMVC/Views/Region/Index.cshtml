@{
    ViewData["Title"] = "Regiones de Chile";
}

<h1>Regiones de Chile</h1>

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.ValueKind == System.Text.Json.JsonValueKind.Array)
    {
        @foreach (var region in Model.EnumerateArray())
        {
            <tr>
                <td>
                    @{
                        System.Text.Json.JsonElement rId;
                        var idProp = region.TryGetProperty("IdRegion", out rId)
                            ? rId
                            : region.GetProperty("idRegion");
                        @idProp
                    }
                </td>
                <td>
                    @{
                        System.Text.Json.JsonElement rNom;
                        var nomProp = region.TryGetProperty("Nombre", out rNom)
                            ? rNom
                            : region.GetProperty("nombre");
                        @nomProp
                    }
                </td>
                <td>
                    @{
                        System.Text.Json.JsonElement idTemp;
                        int idValor;
                        if (region.TryGetProperty("IdRegion", out idTemp))
                        {
                            idValor = idTemp.GetInt32();
                        }
                        else
                        {
                            idValor = region.GetProperty("idRegion").GetInt32();
                        }
                    }
                    <a href="@Url.Action("Comunas", new { idRegion = idValor })">Ver Comunas</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="3">No hay datos disponibles</td>
        </tr>
    }
    </tbody>
</table>

<br />
<a asp-action="Index">Volver al inicio</a>
